# Example environment configuration for Algolia indexing
# Copy this file to .env.local and add your actual keys
# NEVER commit .env.local or any file with real API keys!

# Required for indexing (get from Algolia dashboard)
ALGOLIA_ADMIN_KEY=your-admin-api-key-here

# Optional: Override defaults
# ALGOLIA_APP_ID=your-app-id
# ALGOLIA_SEARCH_API_KEY=your-search-only-api-key
# ALGOLIA_INDEX_NAME=your-index-name
# SITE_URL=https://your-site.com